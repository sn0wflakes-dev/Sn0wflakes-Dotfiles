{
  "position": "top",
  "output": "eDP-1",
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "cpu",
    "temperature",
    "memory",
    "custom/music_prev",
    "custom/music_toggle",
    "custom/music_next",
    "custom/music"
  ],

  "modules-center": [
    "hyprland/window"
    //   "custom/music_prev",
    //   "custom/music_toggle",
    //   "custom/music_next",
    //   "custom/music"
  ],

  "modules-right": ["network", "pulseaudio", "backlight", "battery", "clock"],

  "custom/launcher": {
    "format": "<span size='13000'></span>",
    "tooltip": "false",
    "on-click": "sleep 0.1 && wofi --show drun"
  },

  "hyprland/workspaces": {
    "active-only": false,
    // "all-outputs": true,
    "disable-scroll": false,
    "on-scroll-up": "hyprctl dispatch workspace -1",
    "on-scroll-down": "hyprctl dispatch workspace +1",
    "format": "<span size='13000'>{icon}</span>",
    "on-click": "activate",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "urgent": "!",
      "active": "❅",
      "default": "󰧞",
      "sort-by-number": true
    },
    "presistent-workspaces": {
      "eDP-1": [1, 2, 3, 4, 5]
    }
  },

  "custom/music": {
    "format": "{}",
    "escape": true,
    "interval": 1,
    "tooltip": true,
    "exec": "playerctl --player=spotify metadata --format='{{ default(title,playerName) }}' 2> /dev/null",
    "on-click": "playerctl --player=spotify play-pause",
    "on-scroll-up": "playerctl --player=spotify next",
    "on-scroll-down": "playerctl --player=spotify previous",
    "max-length": 30
  },

  "custom/music_prev": {
    "format": "<span size='15000'>󰒮</span>",
    "interval": 1,
    "tooltip": false,
    "exec": "playerctl --player=spotify metadata 2> /dev/null",
    "on-click": "playerctl --player=spotify previous"
  },

  "custom/music_toggle": {
    "format": "<span size='15000'>{icon}</span>",
    "return-type": "json",
    "exec": "playerctl  --player=spotify -a metadata --format '{\"text\": \"{{playerName}} : {{artist}} - {{markup_escape(default(title, \"\"))}}\", \"tooltip\": \"{{playerName}} : {{markup_escape(default(title,\"\"))}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F 2> /dev/null",
    "format-icons": {
      "Playing": "󰏤",
      "Paused": "󰐊",
      "Stopped": "󰐊"
    },
    "on-click": "playerctl --player=spotify play-pause"
  },

  "custom/music_next": {
    "format": "<span size='15000'>󰒭</span>",
    "interval": 1,
    "tooltip": false,
    "exec": "playerctl --player=spotify metadata 2> /dev/null",
    "on-click": "playerctl --player=spotify next"
  },

  "cpu": {
    // "format": "{usage}% ",
    "format": "{usage}% <span size='13000'></span>",
    "tooltip": true,
    "on-click": "alacritty btop",
    "interval": 1
  },

  // "tray": {
  //  "icon-size": 15,
  //  "spacing": 15
  // },

  "temperature": {
    "thermal-zone": 2,
    "critical-threshold": 40,
    "format-critical": "{temperatureC}°C <span size='13000'>{icon}</span>",
    "format": "{temperatureC}°C <span size='13000'>{icon}</span>",
    "format-icons": ["", "", ""],
    "tooltip": true,
    "on-click": "alacritty btop",
    "interval": 1
  },

  "memory": {
    "format": "{}% <span size='13000'></span>",
    "tooltip": true,
    "on-click": "alacritty btop",
    "interval": 1
  },

  "backlight": {
    // "device": "acpi_video1",
    "format": "{percent}% {icon}",
    "format-icons": ["", ""],
    "on-scroll-up": "brightnessctl set 1%+",
    "on-scroll-down": "brightnessctl set 1%-",
    "interval": 1
  },

  "clock": {
    "format": " {:%a %Y-%m-%d %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },

  "hyprland/window": {
    "format": "{}",
    "rewrite": {
      "": "Hyprland"
    },
    // "separate-outputs": true,
    "max-length": 60
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% <span size='13000'>{icon}</span>",
    "format-warning": "{capacity}% <span size='13000' foreground='#eed49f'>{icon}</span>",
    "format-critical": "{capacity}% <span size='13000' foreground='#ed8796'>{icon}</span>",
    "format-charging": "{capacity}% <span size='13000' foreground='#7dc4e4'></span>",
    "format-plugged": "{capacity}% <span size='13000' foreground='#7dc4e4'></span>",
    "format-alt": "{time} <span size='13000' foreground='#7dc4e4'>{icon}</span>",
    "format-full": "{capacity}% <span size='13000' foreground='#7dc4e4'></span>",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{time}"
  },

  "network": {
    "format-wifi": "{essid} <span size='13000' foreground='#8bd5ca'> </span>",
    "format-ethernet": "Ethernet <span size='13000' foreground='#8bd5ca'></span>",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "Disconnected <span size='13000' foreground='#8bd5ca'>!</span>",
    "tooltip-format-wifi": "Signal Strenght: {signalStrength}%"
  },

  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "]
    },
    "on-click": "pavucontrol"
  }
}
